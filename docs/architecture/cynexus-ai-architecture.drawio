  <diagram id="ai-arch-03" name="03 工具调用与能力治理"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="&lt;b&gt;03 工具调用与能力治理&lt;/b&gt; &amp;#160;&amp;#160;|&amp;#160;&amp;#160;单个 AgentToolCall 从入口到落 run_step，外加启动期能力治理三道校验" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="30" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;AgentToolCall&lt;/b&gt;&lt;br&gt;callId · toolCode · arguments" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d1b2a;" vertex="1" parent="1"><mxGeometry x="350" y="40" width="200" height="60" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;查能力绑定&lt;/b&gt;&lt;br&gt;ai_agent_capability 按 toolCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#1f1408;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="240" height="60" as="geometry" /></mxCell><mxCell id="p3" value="安全属性一致?&lt;br&gt;readOnly / requiresConfirmation" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontColor=#1f1608;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="240" height="80" as="geometry" /></mxCell><mxCell id="p4" value="JSON Schema 校验?&lt;br&gt;≤16000 字符 · 深度 ≤8" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontColor=#1f1608;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="240" height="80" as="geometry" /></mxCell><mxCell id="p5" value="runtimeEntry&lt;br&gt;在白名单内?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontColor=#1f1608;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="240" height="80" as="geometry" /></mxCell><mxCell id="p6" value="&lt;b&gt;匹配 ToolHandler&lt;/b&gt;&lt;br&gt;按 toolCode 查注册表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#1f1408;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="240" height="60" as="geometry" /></mxCell><mxCell id="p7" value="&lt;b&gt;handler.execute()&lt;/b&gt;&lt;br&gt;30+ 只读 Handler 实际干活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#1f1408;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="240" height="60" as="geometry" /></mxCell><mxCell id="p8" value="&lt;b&gt;结果裁剪 / 截断&lt;/b&gt;&lt;br&gt;防止超长回灌撑爆上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#1f1408;" vertex="1" parent="1"><mxGeometry x="330" y="730" width="240" height="60" as="geometry" /></mxCell><mxCell id="p9" value="&lt;b&gt;AgentToolResult&lt;/b&gt;&lt;br&gt;ok · payload / errorText" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#1f1408;" vertex="1" parent="1"><mxGeometry x="330" y="820" width="240" height="60" as="geometry" /></mxCell><mxCell id="p10" value="&lt;b&gt;回 domain 存 run_step&lt;/b&gt;&lt;br&gt;callId · toolCode · 结果 · freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#0d1f0d;" vertex="1" parent="1"><mxGeometry x="330" y="910" width="240" height="60" as="geometry" /></mxCell><mxCell id="p11" value="&lt;b&gt;拒绝执行&lt;/b&gt;&lt;br&gt;返回 errorText + 记 warn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontColor=#1f0d0d;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="220" height="60" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;ai_agent_capability&lt;/b&gt;&lt;br&gt;code · runtime_entry&lt;br&gt;read_only · schema_json" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#0d1b1f;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="80" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;ai_a