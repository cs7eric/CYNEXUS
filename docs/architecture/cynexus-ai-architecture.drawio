  <diagram id="ai-arch-02" name="02 自主Agent主循环"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="3600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="&lt;b&gt;02 自主 Agent 主循环&lt;/b&gt; &amp;#160;&amp;#160;|&amp;#160;&amp;#160;准入四连 → 建会话 → 上下文装配 → 轮次循环（两分支）→ finally 记账" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="30" as="geometry" /></mxCell><mxCell id="s1" value="① 准入四连" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="160" height="20" as="geometry" /></mxCell><mxCell id="s2" value="② 建会话与 run" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="160" height="20" as="geometry" /></mxCell><mxCell id="s3" value="③ 上下文装配" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="160" height="20" as="geometry" /></mxCell><mxCell id="s4" value="④ 轮次循环 turn = 1 .. maxTurns" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="240" height="20" as="geometry" /></mxCell><mxCell id="s5" value="⑤ 收尾与记账 (finally 必执行)" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="40" y="3140" width="240" height="20" as="geometry" /></mxCell><mxCell id="m1" value="&lt;b&gt;POST /agent/run&lt;/b&gt;&lt;br&gt;HTTP + SSE 事件流" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d1b2a;" vertex="1" parent="1"><mxGeometry x="350" y="40" width="180" height="60" as="geometry" /></mxCell><mxCell id="m2" value="&lt;b&gt;AutonomousAgentController&lt;/b&gt;" style="rounded=1;whiteS