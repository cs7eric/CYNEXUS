<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cccs7.cynexus.market.infra.basic.mapper.HeatmapSnapshotMapper">

    <resultMap id="BaseResultMap" type="cn.cccs7.cynexus.market.infra.basic.entity.HeatmapSnapshotPO">
        <id property="id" column="id"/>
        <result property="snapshotDate" column="snapshot_date"/>
        <result property="kind" column="kind"/>
        <result property="source" column="source"/>
        <result property="payload" column="payload" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
