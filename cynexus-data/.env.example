CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_DATABASE=cynexus
CLICKHOUSE_USER=cynexus
CLICKHOUSE_PASSWORD=

# Example: C:\new_tdx
TDX_ROOT=

# Optional Alibaba Cloud DashScope URL transcription. This is additive; the
# existing local Faster Whisper provider remains the default.
CYNEXUS_MEDIA_TRANSCRIPTION_REMOTE_TRANSCRIBER=
CYNEXUS_MEDIA_TRANSCRIPTION_REMOTE_TRANSCRIBER_PARAMS={}
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=paraformer-v2
