<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cccs7.cynexus.core.infra.basic.mapper.DataSourceHealthCheckRunMapper">

    <resultMap id="BaseResultMap" type="cn.cccs7.cynexus.core.infra.basic.entity.DataSourceHealthCheckRunPO">
        <id property="id" column="id"/>
        <result property="runId" column="run_id"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="status" column="status"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="includeSlow" column="include_slow"/>
        <result property="totalCount" column="total_count"/>
        <result property="healthyCount" column="healthy_count"/>
        <result property="degradedCount" column="degraded_count"/>
        <result property="failedCount" column="failed_count"/>
        <result property="skippedCount" column="skipped_count"/>
        <result property="successRate" column="success_rate"/>
        <result property="avgLatencyMs" column="avg_latency_ms"/>
        <result property="errorMessage" column="error_message"/>
        <result property="rawPayload" column="raw_payload" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="extra" column="extra" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectLatest" resultMap="BaseResultMap">
        SELECT *
        FROM data_source_health_check_run
        WHERE deleted_at IS NULL
        ORDER BY started_at DESC
        LIMIT 1
    </select>
</mapper>
