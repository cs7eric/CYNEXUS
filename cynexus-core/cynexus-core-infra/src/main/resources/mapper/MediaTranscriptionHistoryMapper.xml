<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cccs7.cynexus.core.infra.basic.mapper.MediaTranscriptionHistoryMapper">

    <resultMap id="BaseResultMap" type="cn.cccs7.cynexus.core.infra.basic.entity.MediaTranscriptionHistoryPO">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="title" column="title"/>
        <result property="status" column="status"/>
        <result property="fileName" column="file_name"/>
        <result property="recordJson" column="record_json" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectActive" resultMap="BaseResultMap">
        SELECT *
        FROM media_transcription_history
        WHERE deleted_at IS NULL
        ORDER BY sort_order DESC NULLS LAST, created_at DESC, id DESC
    </select>

    <select id="selectActiveById" resultMap="BaseResultMap">
        SELECT *
        FROM media_transcription_history
        WHERE id = #{id}
          AND deleted_at IS NULL
        LIMIT 1
    </select>

    <select id="selectActiveByTaskId" resultMap="BaseResultMap">
        SELECT *
        FROM media_transcription_history
        WHERE task_id = #{taskId}
          AND deleted_at IS NULL
        LIMIT 1
    </select>

    <update id="updateSortOrder">
        UPDATE media_transcription_history
        SET sort_order = #{sortOrder},
            updated_at = now()
        WHERE id = #{id}
          AND deleted_at IS NULL
    </update>

    <update id="softDelete">
        UPDATE media_transcription_history
        SET deleted_at = now(),
            updated_at = now()
        WHERE id = #{id}
          AND deleted_at IS NULL
    </update>
</mapper>
