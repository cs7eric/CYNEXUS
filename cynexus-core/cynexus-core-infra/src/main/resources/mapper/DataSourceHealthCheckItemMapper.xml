<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cccs7.cynexus.core.infra.basic.mapper.DataSourceHealthCheckItemMapper">

    <resultMap id="BaseResultMap" type="cn.cccs7.cynexus.core.infra.basic.entity.DataSourceHealthCheckItemPO">
        <id property="id" column="id"/>
        <result property="runId" column="run_id"/>
        <result property="sourceCode" column="source_code"/>
        <result property="sourceName" column="source_name"/>
        <result property="sourceType" column="source_type"/>
        <result property="category" column="category"/>
        <result property="provider" column="provider"/>
        <result property="description" column="description"/>
        <result property="endpoint" column="endpoint"/>
        <result property="status" column="status"/>
        <result property="connectivity" column="connectivity"/>
        <result property="authenticityStatus" column="authenticity_status"/>
        <result property="latencyMs" column="latency_ms"/>
        <result property="sampleCount" column="sample_count"/>
        <result property="successRate24h" column="success_rate_24h"/>
        <result property="checkedAt" column="checked_at"/>
        <result property="errorMessage" column="error_message"/>
        <result property="checks" column="checks" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="rawPayload" column="raw_payload" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="extra" column="extra" jdbcType="OTHER" typeHandler="cn.cccs7.cynexus.common.db.typehandler.JsonbTypeHandler"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectByRunId" resultMap="BaseResultMap">
        SELECT *
        FROM data_source_health_check_item
        WHERE deleted_at IS NULL
          AND run_id = #{runId}
        ORDER BY category, provider, source_code
    </select>

    <select id="selectSuccessRate24h" resultType="map">
        SELECT
            source_code AS sourceCode,
            ROUND(
                SUM(CASE WHEN status = 'healthy' THEN 1 ELSE 0 END)::numeric
                / NULLIF(COUNT(*), 0) * 100,
                4
            ) AS successRate
        FROM data_source_health_check_item
        WHERE deleted_at IS NULL
          AND checked_at >= now() - interval '24 hours'
        GROUP BY source_code
    </select>
</mapper>
