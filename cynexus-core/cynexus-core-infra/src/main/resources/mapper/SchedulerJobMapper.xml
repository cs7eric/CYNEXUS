<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cccs7.cynexus.core.infra.basic.mapper.SchedulerJobMapper">
    <select id="selectByCode" resultType="cn.cccs7.cynexus.core.infra.basic.entity.SchedulerJobPO">
        SELECT *
        FROM scheduler_jobs
        WHERE code = #{code}
        LIMIT 1
    </select>

    <update id="updateEnabledById">
        UPDATE scheduler_jobs
        SET is_enabled = #{enabled},
            updated_at = now()
        WHERE id = #{id}
    </update>
</mapper>
