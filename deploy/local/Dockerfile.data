FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV CYNEXUS_DATA_PROJECT_ROOT=/app
ENV CYNEXUS_PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium curl \
    && rm -rf /var/lib/apt/lists/*

COPY cynexus-data/requirements.txt /tmp/requirements.txt

# Keep the base data-runtime layer independent from optional live providers.
# BuildKit preserves downloaded wheels across invalidated dependency layers.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt

COPY cynexus-data/requirements-live.txt /tmp/requirements-live.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements-live.txt

COPY cynexus-data/pyproject.toml /app/pyproject.toml
COPY cynexus-data/src/ /app/src/
COPY cynexus-data/sql /app/sql

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --no-deps .

RUN mkdir -p /app/var

EXPOSE 18083

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=20s \
    CMD python -c "import json, urllib.request; data = json.load(urllib.request.urlopen('http://127.0.0.1:18083/internal/health', timeout=3)); raise SystemExit(0 if data.get('ok') else 1)"

CMD ["cynexus-trigger-api", "--host", "0.0.0.0", "--port", "18083"]
