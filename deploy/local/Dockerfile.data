FROM python:3.13-slim

ARG INSTALL_PLAYWRIGHT_BROWSER=false

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY cynexus-data/requirements.txt /tmp/requirements.txt
COPY cynexus-data/requirements-live.txt /tmp/requirements-live.txt

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-live.txt

RUN if [ "$INSTALL_PLAYWRIGHT_BROWSER" = "true" ]; then \
        python -m playwright install --with-deps chromium; \
    fi

COPY cynexus-data/pyproject.toml /app/pyproject.toml
COPY cynexus-data/src /app/src

RUN pip install --no-cache-dir --no-deps .

RUN mkdir -p /app/var

EXPOSE 18083

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=20s \
    CMD python -c "import json, urllib.request; data = json.load(urllib.request.urlopen('http://127.0.0.1:18083/internal/health', timeout=3)); raise SystemExit(0 if data.get('ok') else 1)"

CMD ["cynexus-trigger-api", "--host", "0.0.0.0", "--port", "18083"]
