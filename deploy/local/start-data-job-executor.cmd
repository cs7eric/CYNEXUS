@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $scriptDir='%~dp0'; $composeFile=Join-Path $scriptDir 'docker-compose.yml'; $container=(docker compose -f $composeFile ps -q data-job-executor); $ok=$false; try { $ok=(Invoke-RestMethod -Uri 'http://127.0.0.1:18083/internal/health' -TimeoutSec 2).ok } catch {}; if ($ok -eq $true -and -not $container) { Write-Error '[cynexus-data] Port 18083 is already served outside docker. Stop the local Python executor first, then run this command again.'; exit 1 }; docker compose -f $composeFile up -d --build data-job-executor; Start-Sleep -Seconds 2; Invoke-RestMethod -Uri 'http://127.0.0.1:18083/internal/health' -TimeoutSec 10 | ConvertTo-Json"
