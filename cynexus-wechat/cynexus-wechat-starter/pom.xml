<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.cccs7</groupId>
        <artifactId>cynexus-wechat</artifactId>
        <version>2.6.0-SNAPSHOT</version>
    </parent>
    <artifactId>cynexus-wechat-starter</artifactId>
    <name>cynexus-wechat-starter</name>
    <dependencies>
        <dependency>
            <groupId>cn.cccs7</groupId>
            <artifactId>cynexus-wechat-application-controller</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.cccs7</groupId>
            <artifactId>cynexus-wechat-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.cccs7</groupId>
            <artifactId>cynexus-common-cloud</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.cccs7</groupId>
            <artifactId>cynexus-common-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.cccs7</groupId>
            <artifactId>cynexus-common-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
